[Unit]
Description=bath-monitor server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/xxx/bath-monitor/server
ExecStart=/home/pi/xxx/bath-monitor/server/.venv/bin/python /home/pi/xxx/bath-monitor/server/wsgi.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
